# Runtime logs generated by OpenLDAP containers
logs/
*/logs/

# Local environment files (may contain passwords)
.env
.env.*
!.env.example

# Docker secrets - never commit actual secrets
# Root-anchored patterns like "secrets/*.txt" do NOT match nested paths,
# so they missed docker-secrets/secrets/*.txt. Use ** across the repo.
**/secrets/*.txt
**/secrets/*.key
**/secrets/*.pem

# Backup files
*.bak
*.backup
*~

# IDE and OS files
.vscode
.idea
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
*.tar.gz
*.zip
