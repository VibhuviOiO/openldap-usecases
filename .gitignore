# Runtime logs generated by OpenLDAP containers
logs/
*/logs/

# Local environment files (may contain passwords)
.env
.env.*
!.env.example

# Docker secrets - never commit actual secrets
secrets/*.txt
secrets/*.key
secrets/*.pem

# Backup files
*.bak
*.backup
*~

# IDE and OS files
.vscode
.idea
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
*.tar.gz
*.zip
