# ou=People already exists: the image's create-base-domain.ldif ships
# dc=acme,dc=com, cn=Manager, ou=People, ou=Group and ou=Services. Adding it here
# again is what "ldap_add: Already exists (68)" was.
dn: uid=alice,ou=People,dc=acme,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
uid: alice
cn: Alice Anderson
sn: Anderson
givenName: Alice
mail: alice@acme.com
uidNumber: 10001
gidNumber: 10001
homeDirectory: /home/alice
loginShell: /bin/bash
userPassword: AlicePass123!

